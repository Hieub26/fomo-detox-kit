{
  "name": "fomo-detox-kit",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o app.css --minify",
    "db:start": "supabase start -x studio,imgproxy,storage-api,edge-runtime,realtime,logflare,vector,mailpit,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^3.4.19"
  }
}
